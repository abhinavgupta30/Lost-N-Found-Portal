<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- NMIMS Logo -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logonmims"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nmims_shirpur_logo" />

        <!-- Main Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nmims_red"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/main_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Welcome Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/welcome_title"
            android:textColor="@color/dark_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/welcome_portal_subtitle"
            android:textColor="@color/gray"
            android:textSize="16sp" />

        <!-- View Lost Items -->
        <Button
            android:id="@+id/btnLostItems"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/nmims_red"
            android:text="@string/view_lost_items"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- View Found Items -->
        <Button
            android:id="@+id/btnFoundItems"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/nmims_red"
            android:text="@string/view_found_items"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Report an Item -->
        <Button
            android:id="@+id/btnReportItem"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/nmims_dark_red"
            android:text="@string/report_an_item"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Search Items -->
        <Button
            android:id="@+id/btnSearchItems"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/nmims_red"
            android:text="@string/search_items_button"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
