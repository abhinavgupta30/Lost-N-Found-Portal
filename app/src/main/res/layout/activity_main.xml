<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- NMIMS Logo -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logonmims"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nmims_shirpur_logo" />

        <!-- Main Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nmims_red"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/main_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Welcome Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/welcome_title"
            android:textColor="@color/dark_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/welcome_portal_subtitle"
            android:textColor="@color/gray"
            android:textSize="16sp" />

        <!-- Report Lost Item -->
        <Button
            android:id="@+id/btnReportItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:padding="14dp"
            android:backgroundTint="@color/nmims_red"
            android:text="@string/report_lost_item"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- Acknowledge Found Item -->
        <Button
            android:id="@+id/btnAcknowledgeFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="14dp"
            android:backgroundTint="@color/nmims_red"
            android:text="@string/acknowledge_found_item"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
